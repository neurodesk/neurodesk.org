":1}},"key":"uW4XSzFEGI"}],"key":"CU8UQbVSqQ"},{"type":"code","lang":"Bash","value":"datalad clone osf://ehnwz\n\ncd ehnwz\n\n# now get the files you want to download:\ndatalad get .","position":{"start":{"line":87,"column":1},"end":{"line":94,"column":1}},"key":"t2XAJbByOP"}],"key":"RxAFVWK3gr"}],"key":"vPeAnbzNAM"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Open Data","url":"/tutorials/open-data/intro","group":"Neurodesk"},"next":{"title":"osfclient","url":"/tutorials/open-data/osfclient","group":"Neurodesk"}}},"domain":"http://localhost:3000"}