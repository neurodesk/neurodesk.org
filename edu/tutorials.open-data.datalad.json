umn":1}},"key":"ix8gNHLDix"}],"key":"PK1Eb7GxJk"},{"type":"code","lang":"Bash","value":"\n# create sibling\ndatalad create-sibling-osf --title best-study-ever -s osf\ngit config --global --add datalad.extensions.load next\n\n# push\ndatalad push --to osf\n","position":{"start":{"line":60,"column":1},"end":{"line":69,"column":1}},"key":"o7qecQZlNd"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"The last steps creates a DataLad dataset, which is not easily human readable.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"SG7jv61V1v"}],"key":"b3cnJnNWRa"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"If you would like to create a human-readable dataset (but without the option of downloading it as a datalad dataset later on):","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"VW7X6WKIvE"}],"key":"MpvXvMcG2K"},{"type":"code","lang":"Bash","value":"\n# create sibling\ndatalad create-sibling-osf --title best-study-ever-human-readable --mode exportonly -s osf-export\n\ngit-annex export HEAD --to osf-export-storage\n","position":{"start":{"line":75,"column":1},"end":{"line":82,"column":1}},"key":"hfDWAC1cpp"},{"type":"heading","depth":2,"position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Access a dataset","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"E44QeJ5jZW"}],"identifier":"access-a-dataset","label":"Access a dataset","html_id":"access-a-dataset","implicit":true,"key":"HBBGuu6X8H"},{"type":"paragraph","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"To download a dataset from the OSF (if it was uploaded as a DataLad dataset before):","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"d6FdJS5VlQ"}],"key":"VMSk8qKFld"},{"type":"code","lang":"Bash","value":"datalad clone osf://ehnwz\n\ncd ehnwz\n\n# now get the files you want to download:\ndatalad get .","position":{"start":{"line":87,"column":1},"end":{"line":94,"column":1}},"key":"QD9D4fCdpc"}],"key":"lggkhqOv62"}],"key":"I3yzXzmPSu"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Open Data","url":"/tutorials/open-data/intro","group":"Neurodesk"},"next":{"title":"osfclient","url":"/tutorials/open-data/osfclient","group":"Neurodesk"}}},"domain":"http://localhost:3000"}