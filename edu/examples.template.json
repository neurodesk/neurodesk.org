R.1.101.dcm\u001b[0m\n├── \u001b[00mMR.1.102.dcm\u001b[0m\n├── \u001b[00mMR.1.103.dcm\u001b[0m\n├── \u001b[00mMR.1.104.dcm\u001b[0m\n├── \u001b[00mMR.1.105.dcm\u001b[0m\n├── \u001b[00mMR.1.106.dcm\u001b[0m\n...\nThere are 1216 unsorted DICOMs in ./dicoms-unsorted/\n"},"children":[],"key":"BLIvV3xwfO"}],"visibility":"show","key":"kdnf40GO56"}],"visibility":"show","key":"Ctg67JrrWA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualisation of a dicom (one method for example)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AP1r22CmDe"}],"identifier":"visualisation-of-a-dicom-one-method-for-example","label":"Visualisation of a dicom (one method for example)","html_id":"visualisation-of-a-dicom-one-method-for-example","implicit":true,"key":"g6agTpJmRl"}],"key":"wsrtVm6S6w"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-19T03:25:06.176427Z","iopub.status.busy":"2026-05-19T03:25:06.175980Z","iopub.status.idle":"2026-05-19T03:25:06.482001Z","shell.execute_reply":"2026-05-19T03:25:06.480117Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Define the path to a DICOM file\n# You can change this to any other file in the dicoms-unsorted/ directory\ndcm_path = \"./dicoms-unsorted/MR.1.2.276.0.7230010.3.1.3.0.4480.1677042698.772469.84.dcm\"\n\n# Read the DICOM file into a Python object\nds = pydicom.dcmread(dcm_path)\n\n# ----------------------------\n# Inspecting DICOM metadata (optional)\n# ----------------------------\n\n# Print a few key metadata fields (can be useful for QC or orientation)\nprint(\"Patient ID:\", ds.get(\"PatientID\", \"N/A\"))\nprint(\"Modality:\", ds.get(\"Modality\", \"N/A\"))\nprint(\"Study Date:\", ds.get(\"StudyDate\", \"N/A\"))\n\n# ----------------------------\n# Visualizing the DICOM image\n# ----------------------------\n\n# Display the image stored in the DICOM file using matplotlib\n# Note: Some DICOM files (e.g., non-image series) may not contain pixel data\nplt.imshow(ds.pixel_array, cmap=plt.cm.gray) # Use grayscale color map\nplt.title(\"DICOM Slice: MR.1.1.dcm\") # Title of the plot\nplt.axis(\"off\") # Hide axis ticks/labels for cleaner view\nplt.show()","key":"oI40OAOypD"},{"type":"outputs","id":"UVFUpojZm0Wzy__Mieux1","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Patient ID: 1\nModality: MR\nStudy Date: 20170705\n"},"children":[],"key":"uccFQ7N0Pe"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"5029c4f28739ac44c0c6f068f80cd7ed","path":"/edu/build/5029c4f28739ac44c0c6f068f80cd7ed.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"iEBU35eKJ8"}],"key":"bP0CrJR3qX"}],"key":"X7aZrGG52r"},{"type":"block","kind":"notebook-content","data":{"editable":true,"slideshow":{"slide_type":""},"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Analysis","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ELjvPEYOny"}],"identifier":"id-2-analysis","label":"2. Analysis","html_id":"id-2-analysis","implicit":true,"key":"bqLpswDCjZ"}],"visibility":"show","key":"w3PTmMkiYA"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Be sure to annotate your example. You can also add Markdown blocs to provide explanations.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"A5xcY2A7m2"}],"key":"aDNbvfb5Vs